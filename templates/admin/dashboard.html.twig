{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Administrateur{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Bienvenue, Administrateur!</h1>
            <p class="text-muted">Tableau de bord administrateur</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('logout') }}" class="btn btn-danger">Déconnexion</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Utilisateurs</h5>
                    <p class="card-text display-6">{{ utilisateurs|default(0) }}</p>
                    <small class="text-muted">Utilisateurs totaux</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Étudiants</h5>
                    <p class="card-text display-6">{{ etudiants|default(0) }}</p>
                    <small class="text-muted">Comptes étudiants</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Entreprises</h5>
                    <p class="card-text display-6">{{ entreprises|default(0) }}</p>
                    <small class="text-muted">Comptes entreprises</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Offres</h5>
                    <p class="card-text display-6">{{ offres|default(0) }}</p>
                    <small class="text-muted">Offres de stage</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <h3>Actions rapides</h3>
            <div class="btn-group" role="group">
                <a href="{{ path('admin_users') }}" class="btn btn-primary">Gérer les utilisateurs</a>
                <a href="{{ path('entreprise_register') }}" class="btn btn-info">Créer une entreprise</a>
                <a href="{{ path('admin_offres') }}" class="btn btn-warning">Gérer les offres</a>
                <a href="{{ path('admin_stats') }}" class="btn btn-secondary">Voir les statistiques</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
