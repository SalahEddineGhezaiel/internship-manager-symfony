{% extends 'base.html.twig' %}

{% block title %}Offres de stage — Visiteur{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Offres de stage</h2>
        <div>
            <a href="{{ path('visiteur_home') }}" class="btn btn-secondary">Accueil visiteur</a>
        </div>
    </div>

    {% if offres is empty %}
        <div class="alert alert-info">Aucune offre de stage n'est disponible pour le moment.</div>
    {% else %}
        <div class="row">
            {% for offre in offres %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">{{ offre.titre }}</h5>
                            <h6 class="card-subtitle mb-2 text-muted">{{ offre.entreprise.nom }}</h6>
                            <p class="card-text">
                                {{ offre.localisation }}<br>
                                {{ offre.dateDebut|date('d/m/Y') }} - {{ offre.dateFin|date('d/m/Y') }}
                            </p>
                            <p class="card-text">
                                {% set description = offre.description %}
                                {% if description|length > 100 %}
                                    {{ description|slice(0, 100) }}...
                                {% else %}
                                    {{ description }}
                                {% endif %}
                            </p>
                        </div>
                        <div class="card-footer">
                            <a href="{{ path('visiteur_offre_show', {id: offre.id}) }}" class="btn btn-sm btn-primary">Voir détails</a>
                            <a href="{{ path('login') }}" class="btn btn-sm btn-outline-secondary">Se connecter pour postuler</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
