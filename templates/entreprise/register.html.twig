{% extends 'base.html.twig' %}

{% block title %}Inscription Entreprise{% endblock %}

{% block body %}
<div class="container" style="max-width: 500px; margin: 40px auto;">
    <h1>Inscription Entreprise</h1>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.nom.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.nom.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.email.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.email.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.plainPassword.first) }}
            {{ form_widget(form.plainPassword.first, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.plainPassword.first.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.plainPassword.first.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.plainPassword.second) }}
            {{ form_widget(form.plainPassword.second, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.plainPassword.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.plainPassword.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.adresse) }}
            {{ form_widget(form.adresse, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.adresse.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.adresse.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.secteurActivite) }}
            {{ form_widget(form.secteurActivite, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.secteurActivite.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.secteurActivite.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.siteWeb) }}
            {{ form_widget(form.siteWeb, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.siteWeb.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.siteWeb.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <button class="btn btn-primary w-100" type="submit">S'inscrire</button>
    {{ form_end(form) }}

    <div class="mt-3 text-center">
        <p>Vous avez déjà un compte? <a href="{{ path('login') }}">Se connecter</a></p>
    </div>
</div>
{% endblock %}
