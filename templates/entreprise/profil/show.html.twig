{% extends 'base.html.twig' %}

{% block title %}Mon profil — Entreprise{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Mon profil</h2>
        <div>
            <a href="{{ path('entreprise_dashboard') }}" class="btn btn-secondary">Tableau de bord</a>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="card mb-3">
        <div class="card-header">Informations</div>
        <div class="card-body">
            <p><strong>Nom:</strong> {{ entreprise.nom }}</p>
            <p><strong>Email:</strong> {{ entreprise.email }}</p>
            {% if entreprise.secteurActivite %}
                <p><strong>Secteur d'activité:</strong> {{ entreprise.secteurActivite }}</p>
            {% endif %}
            {% if entreprise.adresse %}
                <p><strong>Adresse:</strong> {{ entreprise.adresse }}</p>
            {% endif %}
            {% if entreprise.siteWeb %}
                <p><strong>Site web:</strong> <a href="{{ entreprise.siteWeb }}" target="_blank">{{ entreprise.siteWeb }}</a></p>
            {% endif %}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Changer le mot de passe</div>
        <div class="card-body">
            {{ form_start(passwordForm) }}
                <div class="mb-3">
                    {{ form_label(passwordForm.currentPassword) }}
                    {{ form_widget(passwordForm.currentPassword, { 'attr': { 'class': 'form-control' } }) }}
                    {% if passwordForm.currentPassword.vars.errors|length > 0 %}
                        <div class="alert alert-danger mt-2">
                            {% for error in passwordForm.currentPassword.vars.errors %}
                                <div>{{ error.message }}</div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                <div class="mb-3">
                    {{ form_label(passwordForm.newPassword.first) }}
                    {{ form_widget(passwordForm.newPassword.first, { 'attr': { 'class': 'form-control' } }) }}
                    {% if passwordForm.newPassword.first.vars.errors|length > 0 %}
                        <div class="alert alert-danger mt-2">
                            {% for error in passwordForm.newPassword.first.vars.errors %}
                                <div>{{ error.message }}</div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                <div class="mb-3">
                    {{ form_label(passwordForm.newPassword.second) }}
                    {{ form_widget(passwordForm.newPassword.second, { 'attr': { 'class': 'form-control' } }) }}
                </div>
                <button type="submit" class="btn btn-primary">Mettre à jour</button>
            {{ form_end(passwordForm) }}
        </div>
    </div>

    <div class="card border-danger">
        <div class="card-header bg-danger text-white">Supprimer mon compte</div>
        <div class="card-body">
            <p>Cette action est irréversible. Vous devez d'abord supprimer vos offres existantes.</p>
            <form method="post" action="{{ path('entreprise_delete_account') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_account' ~ entreprise.id) }}">
                <button type="submit" class="btn btn-danger">Supprimer mon compte</button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
