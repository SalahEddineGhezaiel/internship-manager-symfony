{% extends 'base.html.twig' %}

{% block title %}Candidatures{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Candidatures {% if offre is defined %}— {{ offre.titre }}{% endif %}</h2>
    </div>

    {% if app.flashes('success') %}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
    {% endif %}
    {% if app.flashes('danger') %}
        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
    {% endif %}

    {% if candidatures is empty %}
        <div class="alert alert-info">Aucune candidature pour le moment.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Offre</th>
                        <th>Étudiant</th>
                        <th>Date de soumission</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in candidatures %}
                        <tr>
                            <td>
                                <a href="{{ path('entreprise_candidatures_by_offre', { id: c.offreDeStage.id }) }}">{{ c.offreDeStage.titre }}</a>
                            </td>
                            <td>{{ c.etudiant.prenom }} {{ c.etudiant.nom }}</td>
                            <td>{{ c.dateSoumission|date('d/m/Y H:i') }}</td>
                            <td>
                                {% set badge = c.statut == 'ACCEPTEE' ? 'success' : (c.statut == 'REFUSEE' ? 'danger' : 'secondary') %}
                                <span class="badge bg-{{ badge }}">{{ c.statut }}</span>
                            </td>
                            <td>
                                <a href="{{ path('entreprise_candidature_show', { id: c.id }) }}" class="btn btn-sm btn-info">Voir</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
