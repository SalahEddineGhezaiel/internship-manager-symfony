{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>{{ title }}</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('entreprise_offres_list') }}" class="btn btn-secondary">Retour à mes offres</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre, { 'attr': { 'class': 'form-control' } }) }}
                            {% if form.titre.vars.errors|length > 0 %}
                                <div class="alert alert-danger mt-2">
                                    {% for error in form.titre.vars.errors %}
                                        <div>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description, { 'attr': { 'class': 'form-control', 'rows': 5 } }) }}
                            {% if form.description.vars.errors|length > 0 %}
                                <div class="alert alert-danger mt-2">
                                    {% for error in form.description.vars.errors %}
                                        <div>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.localisation) }}
                            {{ form_widget(form.localisation, { 'attr': { 'class': 'form-control' } }) }}
                            {% if form.localisation.vars.errors|length > 0 %}
                                <div class="alert alert-danger mt-2">
                                    {% for error in form.localisation.vars.errors %}
                                        <div>{{ error.message }}</div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.dateDebut) }}
                                    {{ form_widget(form.dateDebut, { 'attr': { 'class': 'form-control' } }) }}
                                    {% if form.dateDebut.vars.errors|length > 0 %}
                                        <div class="alert alert-danger mt-2">
                                            {% for error in form.dateDebut.vars.errors %}
                                                <div>{{ error.message }}</div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.dateFin) }}
                                    {{ form_widget(form.dateFin, { 'attr': { 'class': 'form-control' } }) }}
                                    {% if form.dateFin.vars.errors|length > 0 %}
                                        <div class="alert alert-danger mt-2">
                                            {% for error in form.dateFin.vars.errors %}
                                                <div>{{ error.message }}</div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="{{ path('entreprise_offres_list') }}" class="btn btn-secondary">Annuler</a>
                            <button class="btn btn-primary" type="submit">
                                {% if offre and offre.id %}
                                    Mettre à jour
                                {% else %}
                                    Créer l'offre
                                {% endif %}
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
