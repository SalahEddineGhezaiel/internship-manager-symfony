{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<h2 class="h4 mb-3">Mon profil</h2>

<div class="row g-3">
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white">Informations</div>
      <div class="card-body">
        <p class="mb-1"><strong>Prénom:</strong> {{ etudiant.prenom }}</p>
        <p class="mb-1"><strong>Nom:</strong> {{ etudiant.nom }}</p>
        <p class="mb-1"><strong>Email:</strong> {{ etudiant.email }}</p>
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white">Changer le mot de passe</div>
      <div class="card-body">
        {{ form_start(passwordForm) }}
          <div class="mb-3">
            {{ form_label(passwordForm.currentPassword) }}
            {{ form_widget(passwordForm.currentPassword, { 'attr': { 'class': 'form-control' } }) }}
            {% if passwordForm.currentPassword.vars.errors|length > 0 %}
              <div class="alert alert-danger mt-2">
                {% for error in passwordForm.currentPassword.vars.errors %}<div>{{ error.message }}</div>{% endfor %}
              </div>
            {% endif %}
          </div>
          <div class="mb-3">
            {{ form_label(passwordForm.newPassword.first) }}
            {{ form_widget(passwordForm.newPassword.first, { 'attr': { 'class': 'form-control' } }) }}
            {% if passwordForm.newPassword.first.vars.errors|length > 0 %}
              <div class="alert alert-danger mt-2">
                {% for error in passwordForm.newPassword.first.vars.errors %}<div>{{ error.message }}</div>{% endfor %}
              </div>
            {% endif %}
          </div>
          <div class="mb-3">
            {{ form_label(passwordForm.newPassword.second) }}
            {{ form_widget(passwordForm.newPassword.second, { 'attr': { 'class': 'form-control' } }) }}
          </div>
          <button type="submit" class="btn btn-primary">Mettre à jour</button>
        {{ form_end(passwordForm) }}
      </div>
    </div>
  </div>
  <div class="col-12">
    <div class="card border-danger shadow-sm">
      <div class="card-header bg-danger text-white">Supprimer mon compte</div>
      <div class="card-body">
        <p>Cette action est irréversible. Toutes vos candidatures seront supprimées.</p>
        <form method="post" action="{{ path('etudiant_delete_account') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete_account' ~ etudiant.id) }}">
          <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Supprimer mon compte</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
