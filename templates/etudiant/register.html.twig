{% extends 'base.html.twig' %}

{% block title %}Inscription Étudiant{% endblock %}

{% block body %}
<div class="row justify-content-center">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header bg-white"><h4 class="mb-0"><i class="bi bi-person-plus"></i> Inscription Étudiant</h4></div>
      <div class="card-body">
    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.prenom) }}
            {{ form_widget(form.prenom, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.prenom.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.prenom.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.nom.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.nom.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.email) }}
            {{ form_widget(form.email, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.email.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.email.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.plainPassword.first) }}
            {{ form_widget(form.plainPassword.first, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.plainPassword.first.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.plainPassword.first.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="mb-3">
            {{ form_label(form.plainPassword.second) }}
            {{ form_widget(form.plainPassword.second, { 'attr': { 'class': 'form-control' } }) }}
            {% if form.plainPassword.vars.errors|length > 0 %}
                <div class="alert alert-danger mt-2">
                    {% for error in form.plainPassword.vars.errors %}
                        <div>{{ error.message }}</div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <button class="btn btn-primary w-100" type="submit">S'inscrire</button>
    {{ form_end(form) }}
      </div>
      <div class="card-footer bg-white text-center">
        <small>Vous avez déjà un compte ? <a href="{{ path('login') }}">Se connecter</a></small>
      </div>
    </div>
  </div>
</div>
{% endblock %}
