{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Étudiant{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Bienvenue, {{ etudiant.prenom }} {{ etudiant.nom }}!</h1>
            <p class="text-muted">Tableau de bord étudiant</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('logout') }}" class="btn btn-danger">Déconnexion</a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Candidatures</h5>
                    <p class="card-text display-6">{{ totalCandidatures|default(0) }}</p>
                    <small class="text-muted">Candidatures soumises</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">En attente</h5>
                    <p class="card-text display-6">{{ enAttente|default(0) }}</p>
                    <small class="text-muted">Réponses en attente</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Acceptées</h5>
                    <p class="card-text display-6">{{ acceptees|default(0) }}</p>
                    <small class="text-muted">Candidatures acceptées</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Refusées</h5>
                    <p class="card-text display-6">{{ refusees|default(0) }}</p>
                    <small class="text-muted">Candidatures refusées</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <h3>Actions rapides</h3>
            <div class="btn-group" role="group">
                <a href="{{ path('etudiant_offres_list') }}" class="btn btn-primary">Voir les offres</a>
                <a href="#" class="btn btn-info">Mes candidatures</a>
                <a href="#" class="btn btn-secondary">Mon profil</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
