{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} - Détails de l'offre{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Détails de l'offre</h2>
                    <a href="{{ path('etudiant_offres_list') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour aux offres
                    </a>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3 class="mb-0">{{ offre.titre }}</h3>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <h5><i class="fas fa-building"></i> Entreprise</h5>
                                <p class="lead">{{ offre.entreprise.nom }}</p>
                                
                                {% if offre.entreprise.secteurActivite %}
                                <p><strong>Secteur d'activité:</strong> {{ offre.entreprise.secteurActivite }}</p>
                                {% endif %}
                                
                                {% if offre.entreprise.adresse %}
                                <p><strong>Adresse:</strong> {{ offre.entreprise.adresse }}</p>
                                {% endif %}
                                
                                {% if offre.entreprise.siteWeb %}
                                <p><strong>Site web:</strong> <a href="{{ offre.entreprise.siteWeb }}" target="_blank">{{ offre.entreprise.siteWeb }}</a></p>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <h5><i class="fas fa-info-circle"></i> Informations du stage</h5>
                                <p><strong>Localisation:</strong> {{ offre.localisation }}</p>
                                <p><strong>Date de début:</strong> {{ offre.dateDebut|date('d/m/Y') }}</p>
                                <p><strong>Date de fin:</strong> {{ offre.dateFin|date('d/m/Y') }}</p>
                                <p><strong>Durée:</strong> 
                                    {% set duration = date(offre.dateFin).diff(date(offre.dateDebut)) %}
                                    {{ duration.days }} jours
                                    {% if duration.days > 30 %}
                                        ({{ (duration.days / 30)|round }} mois environ)
                                    {% endif %}
                                </p>
                            </div>
                        </div>

                        <hr>

                        <div class="mb-4">
                            <h5><i class="fas fa-file-alt"></i> Description du poste</h5>
                            <div class="alert alert-light">
                                {{ offre.description|nl2br }}
                            </div>
                        </div>

                        <div class="text-muted">
                            <small>Offre publiée le {{ offre.dateCreation|date('d/m/Y à H:i') }}</small>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a href="{{ path('etudiant_offres_list') }}" class="btn btn-secondary">
                            <i class="fas fa-list"></i> Voir toutes les offres
                        </a>
                        {% if hasApplied is defined and hasApplied %}
                            <button class="btn btn-outline-success" disabled>
                                <i class="fas fa-check"></i> Vous avez déjà postulé
                            </button>
                        {% else %}
                            <a href="{{ path('etudiant_offre_apply', {id: offre.id}) }}" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Postuler
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}