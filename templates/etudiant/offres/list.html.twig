{% extends 'base.html.twig' %}

{% block title %}Offres de stage disponibles{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Offres de stage disponibles</h2>
                    <a href="{{ path('etudiant_dashboard') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour au tableau de bord
                    </a>
                </div>

                {% if offres is empty %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        Aucune offre de stage n'est disponible pour le moment.
                    </div>
                {% else %}
                    <div class="row">
                        {% for offre in offres %}
                            <div class="col-md-6 col-lg-4 mb-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">{{ offre.titre }}
                                            {% if appliedOffreIds is defined and offre.id in appliedOffreIds %}
                                                <span class="badge bg-success ms-2">Déjà postulé</span>
                                            {% endif %}
                                        </h5>
                                        <h6 class="card-subtitle mb-2 text-muted">
                                            <i class="fas fa-building"></i> {{ offre.entreprise.nom }}
                                        </h6>
                                        <p class="card-text">
                                            <i class="fas fa-map-marker-alt"></i> {{ offre.localisation }}<br>
                                            <i class="fas fa-calendar"></i> {{ offre.dateDebut|date('d/m/Y') }} - {{ offre.dateFin|date('d/m/Y') }}
                                        </p>
                                        <p class="card-text">
                                            {% set description = offre.description %}
                                            {% if description|length > 100 %}
                                                {{ description|slice(0, 100) }}...
                                            {% else %}
                                                {{ description }}
                                            {% endif %}
                                        </p>
                                    </div>
                                    <div class="card-footer">
                                        <a href="{{ path('etudiant_offre_show', {id: offre.id}) }}" class="btn btn-primary btn-sm">
                                            <i class="fas fa-eye"></i> Voir détails
                                        </a>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}